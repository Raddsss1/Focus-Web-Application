{
  "manifest_version": 3,
  "name": "ClassMeet Tracker",
  "version": "1.0.0",
  "description": "Class codes and attendance/participation tracking for Google Meet lessons.",
  "permissions": ["storage"],
  "host_permissions": ["https://meet.google.com/*", "https://*.supabase.co/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "ClassMeet" },
  "content_scripts": [
    { "matches": ["https://meet.google.com/*"], "js": ["content.js"], "run_at": "document_idle" }
  ],
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
}
